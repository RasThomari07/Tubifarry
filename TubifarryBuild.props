<Project>
  <!--
    Tubifarry plugin – local Debug build configuration.
    Imported by Submodules/Lidarr/src/Directory.Build.props when building inside Tubifarry.

    Why: Lidarr submodule compiles with AssemblyVersion=10.0.0.*, but the installed
    Lidarr.Core is 3.1.3.4970. The CLR rejects roll-forward when requested version > loaded
    (10.0.0 > 3.1.3). Using 2.1.1.0 ≤ 3.1.3 makes roll-forward succeed, matching the
    official Tubifarry release build (-p:AssemblyVersion=2.1.1).

    This file is only picked up inside the Tubifarry repo (not in a normal Lidarr clone).
  -->
  <PropertyGroup>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == '' AND '$(Configuration)' == 'Debug'">2.1.1.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == '' AND '$(Configuration)' == 'Debug'">2.1.1.0</FileVersion>
    <Version Condition="'$(Version)' == '' AND '$(Configuration)' == 'Debug'">2.1.1</Version>
  </PropertyGroup>
</Project>
